<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pantalla de arranque de Android 12+: fondo negro de marca y tenedor sin círculo de fondo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/munchify_negro</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/munchify_negro</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/munchify_negro</item>
    </style>
</resources>
